{
  "name": "gmt-leave",
  "version": "1.0.0",
  "private": true,
  "description": "Leave management for Global Marine Transportation Pte Ltd",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",

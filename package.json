    "nodemailer": "6.10.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.12",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.0",

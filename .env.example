# Copy to .env. Never commit real secrets.

# Postgres. Neon and Supabase both work. For Neon, this can be the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leave_app"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Show the fictional staff list and shared demo password on the sign-in page.
# Set to false in any real deployment.
DEMO_LOGIN="true"

# Microsoft Entra ID (Microsoft 365). Leave blank to hide the button.
# Issuer looks like https://login.microsoftonline.com/{tenant-id}/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Email. log writes the message to the server log and the notifications table.
# smtp uses the SMTP_* settings. graph uses Microsoft Graph application permissions.
EMAIL_PROVIDER="log"
EMAIL_FROM="GMT Leave <leave@gmt.example>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional nodemailer URL for the magic-link provider, if you prefer it to SMTP_*.
EMAIL_SERVER=""

GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_SENDER=""

# Files. Leave S3_BUCKET empty to store uploads on local disk (not suitable for Vercel).
UPLOAD_DIR=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Protects /api/cron/daily. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=""

# Set to true only when you intentionally want npm run db:seed to wipe a production database.
SEED_RESET="false"
